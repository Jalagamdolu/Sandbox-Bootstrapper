# Developer Sandbox Bootstrapper - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=data/sandbox_bootstrapper.db

# LLM Planning Configuration (Disabled by default pending owner approval)
ENABLE_OLLAMA_PLANNER=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Approval Governance Settings (Defaults pending owner approval)
APPROVAL_TTL_MINUTES=30

# Sandbox Retention & Capacity Controls (Defaults pending owner approval)
SANDBOX_RETENTION_HOURS=24
SANDBOX_FAILURE_QUARANTINE_HOURS=1
MAX_CONCURRENT_SANDBOXES=5
MAX_STORAGE_BYTES=10737418240

# Local Storage Paths
SANDBOX_STORAGE_DIR=data/sandboxes
MANIFEST_STORAGE_DIR=data/manifests

# Network Bindings
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8000
LOCAL_UI_PORT=8501
