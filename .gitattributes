# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# PowerShell scripts should use CRLF on Windows
*.ps1 text eol=crlf

# Markdown, Python, JSON, YAML, TOML
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.example text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.db binary
